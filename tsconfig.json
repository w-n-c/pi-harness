{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@earendil-works/*": [
        "./agent/install/releases/1.5.0/node_modules/@earendil-works/*"
      ],
      "typebox": [
        "./agent/install/releases/1.5.0/node_modules/typebox"
      ],
      "typebox/*": [
        "./agent/install/releases/1.5.0/node_modules/typebox/*"
      ]
    }
  },
  "include": [
    "agent/extensions/**/*.ts",
    "tests/**/*.ts"
  ]
}
